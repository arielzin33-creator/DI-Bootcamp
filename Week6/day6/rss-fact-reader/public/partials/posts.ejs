<div class="container mt-4">
    <% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
        <% posts.forEach(function(post) { %>
            <div class="post-card">
                <h4 class="post-title">
                    <a href="https://www.thefactsite.com/" target="_blank" rel="noopener noreferrer">
                        <%= post.title %>
                    </a>
                </h4>

                <div class="post-meta">
                    <strong>Published:</strong>
                    <%= post.pubDate %> &nbsp;|&nbsp;
                        <strong>Author:</strong>
                        <%= post.creator || 'Unknown' %> &nbsp;|&nbsp;
                            <strong>Category:</strong>
                            <%= (post.categories && post.categories.length > 0) ? post.categories.join(', ') : 'Uncategorized' %>
                </div>

                <div class="post-content">
                    <%- post.content %>
                </div>
            </div>
            <% }); %>
                <% } else { %>
                    <p class="text-muted text-center mt-5">No posts to display.</p>
                    <% } %>
</div>