PORT=8787

# Any string works locally; generate a real one for anything beyond your
# own machine, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_HTTP_TOKEN=replace-with-a-real-token

# From https://app.tavily.com (free tier). Leave blank to run in mock mode.
TAVILY_API_KEY=

# Ollama's default local address/model. Only used when MOCK_MODE=false.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# true (or leave TAVILY_API_KEY blank) to use canned data for search_web
# and summarize_with_citations instead of calling Tavily / Ollama. See
# README.md's "What's real vs. mocked" section for why this exists and
# what was verified with it on vs. off.
MOCK_MODE=true

NODE_ENV=development
