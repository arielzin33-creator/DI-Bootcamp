{
  "name": "biz2code",
  "version": "0.1.0",
  "private": true,
  "description": "A Linear Gatekeeper for business-validated development",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace server",
    "db:init": "psql \"$DATABASE_URL\" -f server/db/migrations/001_init.sql",
    "db:seed": "npm run seed --workspace server",
    "validate:data": "python3 data/benchmarks/validate_benchmarks.py",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
