# Get a free key at https://openweathermap.org/api  (Sign up -> API keys tab)
# Then copy this file to .env and paste your key below.
#
# NOTE: a brand-new key can take ~10 minutes to 2 hours to activate. Until it does,
# the API returns 401 "Invalid API key" even though the key is correct.
VITE_WEATHER_API_KEY=your_api_key_here
