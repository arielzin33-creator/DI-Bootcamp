# Optional per Google's docs, but recommended — see README.
#
# Get a free key at https://console.cloud.google.com/apis/credentials
#   1. Create (or pick) a project
#   2. APIs & Services -> Library -> enable "Books API"
#   3. APIs & Services -> Credentials -> Create Credentials -> API key
#
# Copy this file to .env and paste your key below.
VITE_GOOGLE_BOOKS_API_KEY=your_api_key_here
