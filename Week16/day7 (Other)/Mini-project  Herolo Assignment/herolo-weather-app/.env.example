# Optional. Without this, the app runs entirely on local mock data (see
# src/api/mockFixtures.js) so it's fully usable out of the box.
#
# Get a free key at https://developer.accuweather.com, then copy this file to
# .env and set the value below to switch the app over to live AccuWeather
# calls with zero code changes.
VITE_ACCUWEATHER_API_KEY=
