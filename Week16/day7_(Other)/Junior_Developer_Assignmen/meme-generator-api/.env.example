# Optional — docker-compose.yml already has working defaults for every one of
# these, so `docker-compose up` runs with zero setup. Copy this to `.env` only if
# you want to override something (e.g. a real DJANGO_SECRET_KEY, or different admin
# credentials).

DJANGO_SECRET_KEY=dev-only-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

POSTGRES_DB=memegen
POSTGRES_USER=memegen_user
POSTGRES_PASSWORD=memegen_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345
