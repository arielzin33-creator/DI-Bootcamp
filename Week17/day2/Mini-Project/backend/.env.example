# Copy this file to `.env` for local development:  cp .env.example .env
# `.env` is gitignored -- never commit real secrets.
# In production (Render) these are set in the dashboard instead, and no .env file is read.

# Node environment: "development" or "production"
NODE_ENV=development

# Port the API listens on. Render injects its own PORT, so leave this for local only.
PORT=4000

# PostgreSQL connection string.
# Local example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storyapp
# On Render use the INTERNAL connection string of your Postgres instance (lower latency,
# stays inside Render's network) -- not the external one.

# Secrets for signing JWTs. Use two DIFFERENT long random strings.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
REFRESH_SECRET=replace_me_with_a_different_long_random_string

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of origins allowed to call this API with credentials.
# Must be the exact frontend origin(s) -- "*" cannot be used with credentialed requests.
CORS_ORIGIN=http://localhost:5173

# Public origin of the FRONTEND. Used to build share links (e.g. <this>/shared/<token>).
# Deliberately configured rather than taken from the request's Host header.
PUBLIC_APP_URL=http://localhost:5173

# --- Optional: Cloudinary, for avatar uploads -------------------------------
# Without these, POST /api/users/me/avatar/signature returns a clear 503 and the UI
# falls back to pasting an image URL. Everything else works normally.
# Find them on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# NEVER commit a real value for this one -- it signs uploads into your account.
CLOUDINARY_API_SECRET=
