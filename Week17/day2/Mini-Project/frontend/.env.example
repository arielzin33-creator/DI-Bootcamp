# Copy to `.env` for local development:  cp .env.example .env
#
# Base URL of the backend API, including the /api prefix.
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# Local:
VITE_API_URL=http://localhost:4000/api
#
# On Render, set this to your deployed backend, e.g.:
# VITE_API_URL=https://storyapp-backend.onrender.com/api
#
# NOTE: this value is baked into the bundle at BUILD time, not read at runtime, so
# changing it on Render requires a redeploy (Manual Deploy > Clear build cache & deploy).
