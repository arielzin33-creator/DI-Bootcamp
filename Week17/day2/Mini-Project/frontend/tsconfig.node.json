{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // A `composite` project is not allowed to disable emit (TS6310), and composite
    // implies `declaration`. So instead of noEmit we emit declarations only, into a
    // scratch folder inside node_modules that never reaches the repo or the build.
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
